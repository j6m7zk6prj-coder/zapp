<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Lumio</AssemblyName>
    <RootNamespace>ZappTV</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>fr</SatelliteResourceLanguages>
    <!-- Seule la version 64 bits de VLC est embarquée (zip deux fois plus léger). -->
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Moteur VLC officiel : lit tous les formats (HLS, TS, MKV, RTMP, RTSP, UDP…) -->
    <PackageReference Include="LibVLCSharp.WPF" Version="3.*" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZappTV.Core\ZappTV.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

</Project>
