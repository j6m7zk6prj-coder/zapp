<UserControl x:Class="ZappTV.Controls.HeroBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="460">
    <Grid x:Name="Root" SizeChanged="Root_SizeChanged" MouseEnter="Root_MouseEnter" MouseLeave="Root_MouseLeave">
        <Border x:Name="Fallback" />
        <!-- Pas d'effet de flou en temps réel (trop coûteux au défilement) :
             le flou vient d'une image décodée en très basse définition puis agrandie. -->
        <Image x:Name="Backdrop" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
        <Image x:Name="LiveLogo" Stretch="Uniform" HorizontalAlignment="Right" Width="440" Margin="0,50,70,90"
               Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality" />

        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#E6000000" Offset="0" />
                    <GradientStop Color="#80000000" Offset="0.5" />
                    <GradientStop Color="#10000000" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00000000" Offset="0.4" />
                    <GradientStop Color="#B3000000" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid Margin="48,0,48,64" VerticalAlignment="Bottom">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel MaxWidth="640" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                <TextBlock x:Name="KindText" FontWeight="SemiBold" FontSize="13" Foreground="#B3FFFFFF" />
                <Image x:Name="TitleLogo" MaxHeight="120" MaxWidth="460" HorizontalAlignment="Left" Stretch="Uniform" Margin="0,16,0,10"
                       Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock x:Name="TitleText" FontFamily="{StaticResource DisplayFont}" FontSize="46" FontWeight="Bold" TextWrapping="Wrap" MaxHeight="120"
                           TextTrimming="CharacterEllipsis" Margin="0,12,0,6" />
                <TextBlock x:Name="SubtitleText" Foreground="#C7FFFFFF" FontSize="15" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="OverviewText" Foreground="#B3FFFFFF" FontSize="14" TextWrapping="Wrap" MaxHeight="42" LineHeight="21"
                           TextTrimming="WordEllipsis" Margin="0,10,0,0" Visibility="Collapsed" />
                <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                    <Button Style="{StaticResource PrimaryButton}" Click="Play_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="PlayGlyph" Text="&#xE768;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,10,0" />
                            <TextBlock x:Name="PlayLabel" Text="Lire" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="FavButton" Style="{StaticResource CircleButton}" Margin="12,0,0,0" Click="Fav_Click">
                        <TextBlock x:Name="FavGlyph" Style="{StaticResource Icon}" FontSize="15" />
                    </Button>
                    <Button Style="{StaticResource CircleButton}" Margin="10,0,0,0" Click="Info_Click" ToolTip="Voir la fiche">
                        <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="15" />
                    </Button>
                </StackPanel>
            </StackPanel>
            <Grid x:Name="Poster" Grid.Column="1" Width="160" Height="240" Margin="28,0,0,0" VerticalAlignment="Bottom">
                <Border CornerRadius="16">
                    <Border.Background>
                        <ImageBrush x:Name="PosterBrush" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <Border CornerRadius="16" BorderBrush="{StaticResource GlassStroke}" BorderThickness="1" />
            </Grid>
        </Grid>

        <!-- Navigation du carrousel : flèches et points regroupés en bas à droite, rien ne chevauche le texte -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,48,18">
            <Button x:Name="PrevButton" Style="{StaticResource CircleButton}" Width="30" Height="30" Click="Prev_Click" Visibility="Hidden" ToolTip="Précédent">
                <TextBlock Text="&#xE76B;" Style="{StaticResource Icon}" FontSize="11" />
            </Button>
            <StackPanel x:Name="Dots" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,12,0" />
            <Button x:Name="NextButton" Style="{StaticResource CircleButton}" Width="30" Height="30" Click="Next_Click" Visibility="Hidden" ToolTip="Suivant">
                <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="11" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
