<UserControl x:Class="ZappTV.Controls.HeroBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="400">
    <Grid x:Name="Root" SizeChanged="Root_SizeChanged" MouseEnter="Root_MouseEnter" MouseLeave="Root_MouseLeave">
        <Border x:Name="Fallback" />
        <Image x:Name="Backdrop" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
            <Image.Effect>
                <BlurEffect Radius="36" KernelType="Gaussian" />
            </Image.Effect>
        </Image>
        <Image x:Name="LiveLogo" Stretch="Uniform" HorizontalAlignment="Right" Width="440" Margin="0,50,70,90"
               Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality" />

        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#E6000000" Offset="0" />
                    <GradientStop Color="#80000000" Offset="0.5" />
                    <GradientStop Color="#10000000" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00000000" Offset="0.4" />
                    <GradientStop Color="#B3000000" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid Margin="48,0,48,46" VerticalAlignment="Bottom">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel MaxWidth="640" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                <TextBlock x:Name="KindText" Foreground="{DynamicResource AccentBrush}" FontWeight="Black" FontSize="13" />
                <TextBlock x:Name="TitleText" FontSize="42" FontWeight="Black" TextWrapping="Wrap" MaxHeight="112"
                           TextTrimming="CharacterEllipsis" Margin="0,6,0,4" />
                <TextBlock x:Name="SubtitleText" Foreground="#C7FFFFFF" FontSize="15" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                    <Button Style="{StaticResource PrimaryButton}" Click="Play_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="PlayGlyph" Text="&#xE768;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,10,0" />
                            <TextBlock x:Name="PlayLabel" Text="Lire" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="FavButton" Style="{StaticResource CircleButton}" Margin="12,0,0,0" Click="Fav_Click">
                        <TextBlock x:Name="FavGlyph" Style="{StaticResource Icon}" FontSize="15" />
                    </Button>
                    <Button Style="{StaticResource CircleButton}" Margin="10,0,0,0" Click="Info_Click" ToolTip="Voir la fiche">
                        <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="15" />
                    </Button>
                </StackPanel>
            </StackPanel>
            <Border x:Name="Poster" Grid.Column="1" Width="170" Height="255" CornerRadius="14" Margin="28,0,0,0" VerticalAlignment="Bottom">
                <Border.Background>
                    <ImageBrush x:Name="PosterBrush" Stretch="UniformToFill" />
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.6" Direction="270" />
                </Border.Effect>
            </Border>
        </Grid>

        <StackPanel x:Name="Dots" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,48,20" />

        <Button x:Name="PrevButton" Style="{StaticResource CircleButton}" HorizontalAlignment="Left" Margin="14,0,0,0"
                Click="Prev_Click" Visibility="Hidden">
            <TextBlock Text="&#xE76B;" Style="{StaticResource Icon}" />
        </Button>
        <Button x:Name="NextButton" Style="{StaticResource CircleButton}" HorizontalAlignment="Right" Margin="0,0,14,0"
                Click="Next_Click" Visibility="Hidden">
            <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" />
        </Button>
    </Grid>
</UserControl>
