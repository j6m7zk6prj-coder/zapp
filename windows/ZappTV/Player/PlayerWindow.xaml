<Window x:Class="ZappTV.Player.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Zapp TV" Width="1280" Height="760" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen" Icon="/Assets/app.ico"
        Background="Black" Foreground="White" FontFamily="{StaticResource UiFont}">
    <vlc:VideoView x:Name="Video" Background="Black">
        <!-- Commandes affichées par-dessus la vidéo (fond presque transparent pour capter la souris) -->
        <Grid x:Name="Overlay" Background="#01000000" Focusable="True"
              MouseMove="Overlay_MouseMove" MouseLeftButtonDown="Overlay_MouseLeftButtonDown" MouseWheel="Overlay_MouseWheel">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Barre du haut -->
            <Border x:Name="TopBar" Padding="22,16,22,44">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#D9000000" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <DockPanel>
                    <Button DockPanel.Dock="Left" Style="{StaticResource CircleButton}" Width="42" Height="42" Click="Close_Click" ToolTip="Fermer (Échap)">
                        <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="14" />
                    </Button>
                    <Button x:Name="ListButton" DockPanel.Dock="Right" Style="{StaticResource CircleButton}" Width="42" Height="42"
                            Click="List_Click" ToolTip="Liste des chaînes (L)">
                        <TextBlock Text="&#xE8FD;" Style="{StaticResource Icon}" FontSize="15" />
                    </Button>
                    <Grid x:Name="LogoBox" Width="70" Height="40" Margin="16,0,0,0">
                        <Border x:Name="LogoFallback" CornerRadius="8">
                            <TextBlock x:Name="LogoInitials" FontWeight="Black" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="LogoImageBox" CornerRadius="8" Background="#33FFFFFF">
                            <Image x:Name="LogoImage" Stretch="Uniform" Margin="5,4" />
                        </Border>
                    </Grid>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="LiveBadge" Background="#E5484D" CornerRadius="4" Padding="6,1" Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="DIRECT" FontSize="11" FontWeight="Black" />
                            </Border>
                            <TextBlock x:Name="TitleText" FontSize="19" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock x:Name="SubtitleText" FontSize="13" Foreground="#B3FFFFFF" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Chargement / erreur -->
            <StackPanel x:Name="BufferingPanel" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <ProgressBar IsIndeterminate="True" Width="180" Height="4" Foreground="{DynamicResource AccentBrush}" Background="#33FFFFFF" BorderThickness="0" />
                <TextBlock Text="Chargement du flux…" HorizontalAlignment="Center" Margin="0,12,0,0" Foreground="#CCFFFFFF" />
            </StackPanel>

            <Border x:Name="ErrorPanel" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                    Background="#F21A1C24" CornerRadius="20" Padding="30,24" MaxWidth="460">
                <StackPanel>
                    <TextBlock Text="&#xE783;" Style="{StaticResource Icon}" FontSize="34" Foreground="#FFA53D" HorizontalAlignment="Center" />
                    <TextBlock Text="Impossible de lire ce flux" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,6" />
                    <TextBlock x:Name="ErrorText" Foreground="#B3FFFFFF" TextWrapping="Wrap" TextAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                        <Button Style="{StaticResource AccentButton}" Content="Réessayer" Click="Retry_Click" />
                        <Button x:Name="ErrorNextButton" Style="{StaticResource GhostButton}" Content="Chaîne suivante" Margin="10,0,0,0" Click="Next_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Barre du bas -->
            <Border x:Name="BottomBar" Grid.Row="2" Padding="24,44,24,18">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#E6000000" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel>
                    <Grid x:Name="SeekRow" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TimeText" Text="0:00" FontSize="13" VerticalAlignment="Center" MinWidth="56" />
                        <Slider x:Name="Seek" Grid.Column="1" Minimum="0" Maximum="1" Margin="12,0" VerticalAlignment="Center"
                                IsMoveToPointEnabled="True" Foreground="{DynamicResource AccentBrush}"
                                PreviewMouseLeftButtonDown="Seek_MouseDown" PreviewMouseLeftButtonUp="Seek_MouseUp" />
                        <TextBlock x:Name="RemainingText" Grid.Column="2" FontSize="13" VerticalAlignment="Center" MinWidth="56" TextAlignment="Right" />
                    </Grid>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <Button x:Name="PrevButton" Style="{StaticResource CircleButton}" Click="Prev_Click" ToolTip="Chaîne précédente (↑)">
                                <TextBlock Text="&#xE70E;" Style="{StaticResource Icon}" FontSize="15" />
                            </Button>
                            <Button Style="{StaticResource CircleButton}" Width="54" Height="54" Margin="10,0" Click="PlayPause_Click" ToolTip="Lecture / pause (Espace)">
                                <TextBlock x:Name="PlayPauseGlyph" Text="&#xE769;" Style="{StaticResource Icon}" FontSize="20" />
                            </Button>
                            <Button x:Name="NextButton" Style="{StaticResource CircleButton}" Click="Next_Click" ToolTip="Chaîne suivante (↓)">
                                <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="15" />
                            </Button>
                            <Button x:Name="BackTenButton" Style="{StaticResource GhostButton}" Margin="14,0,0,0" Click="BackTen_Click" Content="− 10 s" ToolTip="Reculer (←)" VerticalAlignment="Center" />
                            <Button x:Name="ForwardTenButton" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="ForwardTen_Click" Content="+ 10 s" ToolTip="Avancer (→)" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource IconButton}" Click="Mute_Click" ToolTip="Muet (M)">
                                <TextBlock x:Name="VolumeGlyph" Text="&#xE767;" Style="{StaticResource Icon}" FontSize="18" />
                            </Button>
                            <Slider x:Name="VolumeSlider" Width="120" Minimum="0" Maximum="100" VerticalAlignment="Center" Margin="6,0,14,0"
                                    IsMoveToPointEnabled="True" Foreground="{DynamicResource AccentBrush}" ValueChanged="Volume_ValueChanged" />
                            <Button Style="{StaticResource IconButton}" Click="Fullscreen_Click" ToolTip="Plein écran (F)">
                                <TextBlock x:Name="FullscreenGlyph" Text="&#xE740;" Style="{StaticResource Icon}" FontSize="18" />
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="HintText" Text="VLC" FontSize="12" Foreground="#80FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Liste de zapping -->
            <Border x:Name="ChannelPanel" Grid.RowSpan="3" HorizontalAlignment="Right" Width="360" Background="#EB101218"
                    Visibility="Collapsed" BorderBrush="#26FFFFFF" BorderThickness="1,0,0,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="20,18,12,10">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="List_Click" ToolTip="Fermer">
                            <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="12" />
                        </Button>
                        <TextBlock Text="Chaînes" FontSize="19" FontWeight="Bold" VerticalAlignment="Center" />
                    </DockPanel>
                    <ListBox x:Name="ChannelList" Style="{StaticResource PlainList}" Padding="8,0,8,14">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource RowButton}" Click="Channel_Click" Tag="{Binding Index}">
                                    <Grid Height="40">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Number}" FontSize="12" Foreground="#80FFFFFF" VerticalAlignment="Center" />
                                        <Grid Grid.Column="1" Width="56" Height="32" HorizontalAlignment="Left">
                                            <Border CornerRadius="6" Background="{Binding Title, Converter={StaticResource Gradient}}">
                                                <TextBlock Text="{Binding Initials}" FontSize="11" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Border CornerRadius="6" Background="#33FFFFFF" Visibility="{Binding HasLogo, Converter={StaticResource BoolToVisibility}}">
                                                <Image Source="{Binding Logo, Converter={StaticResource ImageUrl}, ConverterParameter=100}" Stretch="Uniform" Margin="4,3" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Grid.Column="2" Text="{Binding Title}" VerticalAlignment="Center" Margin="10,0,6,0" TextTrimming="CharacterEllipsis" FontSize="14" />
                                        <TextBlock Grid.Column="3" Text="&#xE767;" Style="{StaticResource Icon}" FontSize="13"
                                                   Foreground="{DynamicResource AccentBrush}" Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </vlc:VideoView>
</Window>
