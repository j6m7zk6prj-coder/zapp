<Window x:Class="ZappTV.Dialogs.LinkEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ZappTV.Controls"
        Title="Nouveau lien" Width="620" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="/Assets/app.ico"
        Background="{DynamicResource SurfaceBrush}" Foreground="White" FontFamily="{StaticResource UiFont}">
    <StackPanel Margin="30,24,30,26">
        <TextBlock x:Name="Heading" Text="Nouveau lien" FontSize="24" FontWeight="Black" />
        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                   Text="HLS (.m3u8), MP4, TS, MKV, AVI, FLV, RTMP, RTSP, UDP, RTP, SRT, MMS… tout est lu par VLC." />

        <TextBlock Text="Lien du flux" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="UrlBox" Style="{StaticResource Field}" Tag="http://…/flux.m3u8, rtmp://…, udp://@…" TextChanged="Url_TextChanged" />
        <TextBlock x:Name="FormatText" Margin="3,8,0,0" FontSize="13" />

        <Border x:Name="PlaylistBanner" Visibility="Collapsed" Background="#1FFFFFFF" CornerRadius="12" Padding="16,12" Margin="0,12,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="AddAsPlaylist_Click" Content="L'ajouter comme playlist" Margin="12,0,0,0" />
                <TextBlock Text="Ce lien ressemble à une playlist complète (plusieurs chaînes)." TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <TextBlock Text="Nom" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="NameBox" Style="{StaticResource Field}" Tag="Ex. : Ma chaîne" TextChanged="Name_TextChanged" />

        <TextBlock Text="Type" Style="{StaticResource FieldLabel}" />
        <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="KindLive" Style="{StaticResource Chip}" Content="Chaîne en direct" Click="Kind_Click" />
            <RadioButton x:Name="KindMovie" Style="{StaticResource Chip}" Content="Film / vidéo" Click="Kind_Click" />
        </StackPanel>

        <TextBlock Text="Catégorie" Style="{StaticResource FieldLabel}" />
        <c:CategoryBox x:Name="CategoryInput" />

        <TextBlock Text="Logo" Style="{StaticResource FieldLabel}" />
        <c:LogoPicker x:Name="Logo" />

        <TextBlock x:Name="ErrorText" Foreground="#FFB347" Margin="2,14,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

        <DockPanel Margin="0,26,0,0" LastChildFill="False">
            <Button x:Name="SaveButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Click="Save_Click" IsDefault="True" Content="Ajouter" MinWidth="110" />
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Margin="0,0,10,0" IsCancel="True" Content="Annuler" />
            <Button x:Name="TestButton" DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Click="Test_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                    <TextBlock Text="Tester" />
                </StackPanel>
            </Button>
            <Button x:Name="DeleteButton" DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Foreground="#FF7A7A"
                    Margin="10,0,0,0" Click="Delete_Click" Content="Supprimer" Visibility="Collapsed" />
        </DockPanel>
    </StackPanel>
</Window>
