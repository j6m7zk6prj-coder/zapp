<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:ZappTV">

    <local:ImageUrlConverter x:Key="ImageUrl" />
    <local:GradientConverter x:Key="Gradient" />
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <!-- Menu de l'appui droit sur une carte -->
    <ContextMenu x:Key="TileMenu" x:Shared="False">
        <MenuItem Header="Lire" Command="{x:Static local:AppCommands.Play}" CommandParameter="{Binding}" />
        <MenuItem Header="{Binding FavoriteLabel}" Command="{x:Static local:AppCommands.ToggleFavorite}" CommandParameter="{Binding}" />
        <MenuItem Header="Voir la fiche" Command="{x:Static local:AppCommands.Details}" CommandParameter="{Binding}" />
        <MenuItem Header="Modifier nom, logo, catégorie…" Command="{x:Static local:AppCommands.Edit}" CommandParameter="{Binding}" />
        <Separator />
        <MenuItem Header="Masquer" Command="{x:Static local:AppCommands.Hide}" CommandParameter="{Binding}" />
    </ContextMenu>

    <!-- Affiche 2:3 (films, séries) -->
    <DataTemplate x:Key="PosterTile" DataType="{x:Type local:Tile}">
        <Button Style="{StaticResource TileButton}" Width="{Binding Width}" Margin="{Binding Margin}"
                Command="{x:Static local:AppCommands.Open}" CommandParameter="{Binding}"
                ContextMenu="{StaticResource TileMenu}" ToolTip="{Binding Item.Name}">
            <StackPanel>
                <Grid Height="{Binding ArtHeight}">
                    <Grid.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="5" Opacity="0.45" Direction="270" />
                    </Grid.Effect>
                    <Border CornerRadius="12" Background="{Binding Item.Name, Converter={StaticResource Gradient}}">
                        <TextBlock Text="{Binding Item.DisplayName}" FontSize="15" FontWeight="Black" TextWrapping="Wrap"
                                   VerticalAlignment="Bottom" Margin="12" MaxHeight="90" TextTrimming="CharacterEllipsis" />
                    </Border>
                    <Border CornerRadius="12" Visibility="{Binding HasLogo, Converter={StaticResource BoolToVisibility}}">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Item.LogoUrl, Converter={StaticResource ImageUrl}, ConverterParameter=320}"
                                        Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                    <Border CornerRadius="12" BorderBrush="#1FFFFFFF" BorderThickness="1" />
                    <Border Width="26" Height="26" CornerRadius="13" Background="#A6000000" Margin="8"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="&#xEB52;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="#FF5C93"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
                <TextBlock Text="{Binding Item.Name}" Margin="2,9,2,0" FontSize="13" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Button>
    </DataTemplate>

    <!-- Vignette 16:9 (chaînes) : logo centré sur fond sombre -->
    <DataTemplate x:Key="LandscapeTile" DataType="{x:Type local:Tile}">
        <Button Style="{StaticResource TileButton}" Width="{Binding Width}" Margin="{Binding Margin}"
                Command="{x:Static local:AppCommands.Open}" CommandParameter="{Binding}"
                ContextMenu="{StaticResource TileMenu}" ToolTip="{Binding Item.Name}">
            <StackPanel>
                <Grid Height="{Binding ArtHeight}">
                    <Grid.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="5" Opacity="0.45" Direction="270" />
                    </Grid.Effect>
                    <Border CornerRadius="12" Background="{Binding Item.Name, Converter={StaticResource Gradient}}">
                        <TextBlock Text="{Binding Item.Initials}" FontSize="30" FontWeight="Black"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border CornerRadius="12" Background="{DynamicResource SurfaceHighBrush}"
                            Visibility="{Binding HasLogo, Converter={StaticResource BoolToVisibility}}">
                        <Image Source="{Binding Item.LogoUrl, Converter={StaticResource ImageUrl}, ConverterParameter=260}"
                               Stretch="Uniform" Margin="22,16" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <Border CornerRadius="12" BorderBrush="#1FFFFFFF" BorderThickness="1" />
                    <Border Width="26" Height="26" CornerRadius="13" Background="#A6000000" Margin="8"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="&#xEB52;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="#FF5C93"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
                <TextBlock Text="{Binding Item.Name}" Margin="2,9,2,0" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Item.Group}" Margin="2,2,2,0" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Button>
    </DataTemplate>

    <local:TileTemplateSelector x:Key="TileSelector"
                                PosterTemplate="{StaticResource PosterTile}"
                                LandscapeTemplate="{StaticResource LandscapeTile}" />

    <!-- Ligne de liste (direct en liste, recherche) -->
    <DataTemplate x:Key="ListRow" DataType="{x:Type local:Tile}">
        <Button Style="{StaticResource RowButton}" Command="{x:Static local:AppCommands.Open}" CommandParameter="{Binding}"
                ContextMenu="{StaticResource TileMenu}" Margin="0,0,8,2">
            <Grid Height="58">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="104" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="96" Height="54" HorizontalAlignment="Left">
                    <Border CornerRadius="8" Background="{Binding Item.Name, Converter={StaticResource Gradient}}">
                        <TextBlock Text="{Binding Item.Initials}" FontSize="16" FontWeight="Black"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border CornerRadius="8" Background="{DynamicResource SurfaceHighBrush}"
                            Visibility="{Binding HasLogo, Converter={StaticResource BoolToVisibility}}">
                        <Image Source="{Binding Item.LogoUrl, Converter={StaticResource ImageUrl}, ConverterParameter=120}"
                               Stretch="Uniform" Margin="8,6" />
                    </Border>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                    <TextBlock Text="{Binding Item.Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Margin="0,2,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="&#xEB52;" Style="{StaticResource Icon}" FontSize="13" Foreground="#FF5C93" Margin="0,0,14,0"
                               Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding ActionGlyph}" Style="{StaticResource Icon}" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Button>
    </DataTemplate>

    <!-- Rangée de la grille virtualisée -->
    <DataTemplate x:Key="TileRowTemplate" DataType="{x:Type local:TileRow}">
        <ItemsControl ItemsSource="{Binding Tiles}" ItemTemplateSelector="{StaticResource TileSelector}" Margin="0,0,0,26">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </DataTemplate>

</ResourceDictionary>
