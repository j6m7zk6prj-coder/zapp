<Window x:Class="ZappTV.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iTv" Width="1400" Height="860" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen" Icon="/Assets/app.ico"
        Background="{DynamicResource BgBrush}" Foreground="White" FontFamily="{StaticResource UiFont}"
        AllowDrop="True" Drop="Window_Drop" PreviewKeyDown="Window_PreviewKeyDown" PreviewMouseDown="Window_PreviewMouseDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Barre latérale (comme l'app TV sur Mac) -->
        <Border Background="#FF0E0E11" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,16,12,14">
                <!-- Logo -->
                <Button DockPanel.Dock="Top" Style="{StaticResource PlainButton}" Click="Logo_Click" Margin="6,0,0,18" HorizontalAlignment="Left" ToolTip="Accueil">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Assets/logo.png" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="iTv" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" Margin="10,0,0,1" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Retour -->
                <Button x:Name="BackButton" DockPanel.Dock="Top" Style="{StaticResource PlainButton}" Click="Back_Click" Visibility="Collapsed"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,8" ToolTip="Retour (Alt+←)">
                    <Border CornerRadius="8" Padding="10,7" Background="#0FFFFFFF">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72B;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,10,0" />
                            <TextBlock Text="Retour" FontSize="13" />
                        </StackPanel>
                    </Border>
                </Button>

                <!-- Bas : profil et réglages -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Height="1" Background="{StaticResource HairlineBrush}" Margin="4,8,4,8" />
                    <RadioButton x:Name="NavSettings" Style="{StaticResource SidebarItem}" GroupName="Nav" Tag="settings" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource NavIcon}" />
                            <TextBlock Text="Réglages" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <Button x:Name="AvatarButton" Style="{StaticResource PlainButton}" Click="Avatar_Click" Margin="0,4,0,0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" ToolTip="Profil">
                        <Border CornerRadius="8" Padding="8,7" Background="Transparent" x:Name="ProfileRow">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="10" Opacity="0.6" VerticalAlignment="Center" />
                                <Border x:Name="AvatarCircle" Width="26" Height="26" CornerRadius="13" Background="{DynamicResource AccentBrush}">
                                    <TextBlock x:Name="AvatarText" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock x:Name="ProfileName" FontSize="13" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </Border>
                    </Button>
                </StackPanel>

                <!-- Navigation -->
                <StackPanel>
                    <RadioButton x:Name="NavSearch" Style="{StaticResource SidebarItem}" GroupName="Nav" Tag="search" Checked="Nav_Checked" Margin="0,0,0,10">
                        <Border Background="#14FFFFFF" CornerRadius="7" Padding="8,5" Margin="-6,0,-6,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="12" Opacity="0.7" Margin="0,0,9,0" />
                                <TextBlock Text="Rechercher" FontSize="13" Opacity="0.7" />
                            </StackPanel>
                        </Border>
                    </RadioButton>

                    <RadioButton x:Name="NavHome" Style="{StaticResource SidebarItem}" GroupName="Nav" Tag="home" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" Style="{StaticResource NavIcon}" />
                            <TextBlock Text="Accueil" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavLive" Style="{StaticResource SidebarItem}" GroupName="Nav" Tag="live" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7F4;" Style="{StaticResource NavIcon}" />
                            <TextBlock Text="Direct" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavMovies" Style="{StaticResource SidebarItem}" GroupName="Nav" Tag="movies" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B2;" Style="{StaticResource NavIcon}" />
                            <TextBlock Text="Films" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavSeries" Style="{StaticResource SidebarItem}" GroupName="Nav" Tag="series" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A9;" Style="{StaticResource NavIcon}" />
                            <TextBlock Text="Séries" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavFoot" Style="{StaticResource SidebarItem}" GroupName="Nav" Tag="foot" Checked="Nav_Checked">
                        <DockPanel>
                            <Ellipse x:Name="LiveDot" DockPanel.Dock="Right" Width="7" Height="7" Fill="#FF453A" Margin="8,0,2,0" VerticalAlignment="Center" Visibility="Collapsed" ToolTip="Match en direct" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE909;" Style="{StaticResource NavIcon}" />
                                <TextBlock Text="Foot" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                    </RadioButton>

                    <TextBlock Text="Bibliothèque" FontSize="11" FontWeight="SemiBold" Opacity="0.45" Margin="10,18,0,6" />
                    <RadioButton x:Name="NavLinks" Style="{StaticResource SidebarItem}" GroupName="Nav" Tag="links" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71B;" Style="{StaticResource NavIcon}" />
                            <TextBlock Text="Mes liens" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <Button x:Name="AddButton" Style="{StaticResource PlainButton}" Click="Add_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,1,0,0">
                        <Border CornerRadius="8" Padding="10,0" Height="36" Background="Transparent">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Opacity="0.75">
                                <TextBlock Text="&#xE710;" Style="{StaticResource NavIcon}" />
                                <TextBlock Text="Ajouter…" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Ajouter un lien de flux…" Click="AddLink_Click" />
                                <MenuItem Header="Coller un lien (Ctrl+V)" Click="PasteLink_Click" />
                                <MenuItem Header="Ajouter une playlist…" Click="AddPlaylist_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
        <ProgressBar x:Name="LoadingBar" Grid.ColumnSpan="2" IsIndeterminate="True" Height="2" VerticalAlignment="Top" Visibility="Collapsed"
                     Foreground="{DynamicResource AccentBrush}" Background="Transparent" BorderThickness="0" />

        <!-- Contenu -->
        <Grid Grid.Column="1" Background="{DynamicResource BackdropBrush}" ClipToBounds="True">
            <ContentControl x:Name="Host" Focusable="False" />

            <Border x:Name="Toast" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28"
                    Background="#F21C1C1E" CornerRadius="10" Padding="16,10" BorderBrush="#26FFFFFF" BorderThickness="1"
                    Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock x:Name="ToastText" FontSize="13" />
            </Border>
        </Grid>
    </Grid>
</Window>
