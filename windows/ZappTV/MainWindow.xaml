<Window x:Class="ZappTV.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iTv" Width="1400" Height="860" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen" Icon="/Assets/app.ico"
        Background="{DynamicResource BgBrush}" Foreground="White" FontFamily="{StaticResource UiFont}"
        AllowDrop="True" Drop="Window_Drop" PreviewKeyDown="Window_PreviewKeyDown" PreviewMouseDown="Window_PreviewMouseDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barre du haut : onglets en pastilles -->
        <Border Background="{DynamicResource TopBarBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="20,12,20,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BackButton" Style="{StaticResource CircleButton}" Width="38" Height="38" Margin="0,0,14,0"
                            Click="Back_Click" Visibility="Collapsed" ToolTip="Retour (Alt+←)">
                        <TextBlock Text="&#xE72B;" Style="{StaticResource Icon}" FontSize="14" />
                    </Button>
                    <Button Style="{StaticResource PlainButton}" Click="Logo_Click" ToolTip="Accueil">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/logo.png" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="iTv" FontFamily="{StaticResource DisplayFont}" FontSize="23" FontWeight="SemiBold" Margin="10,0,0,2" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Grid.Column="1" Background="#14FFFFFF" CornerRadius="100" Padding="5" VerticalAlignment="Center">
                    <StackPanel x:Name="Tabs" Orientation="Horizontal">
                        <RadioButton x:Name="NavHome" Style="{StaticResource TopTab}" GroupName="Nav" Tag="home" Checked="Nav_Checked" Content="Pour toi" />
                        <RadioButton x:Name="NavLive" Style="{StaticResource TopTab}" GroupName="Nav" Tag="live" Checked="Nav_Checked" Content="Direct" />
                        <RadioButton x:Name="NavMovies" Style="{StaticResource TopTab}" GroupName="Nav" Tag="movies" Checked="Nav_Checked" Content="Films" />
                        <RadioButton x:Name="NavSeries" Style="{StaticResource TopTab}" GroupName="Nav" Tag="series" Checked="Nav_Checked" Content="Séries" />
                        <RadioButton x:Name="NavFoot" Style="{StaticResource TopTab}" GroupName="Nav" Tag="foot" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Foot" />
                                <Ellipse x:Name="LiveDot" Width="8" Height="8" Fill="#E5484D" Margin="7,1,0,0" VerticalAlignment="Center" Visibility="Collapsed" ToolTip="Match en direct" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavLinks" Style="{StaticResource TopTab}" GroupName="Nav" Tag="links" Checked="Nav_Checked" Content="Mes liens" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="ClockText" FontSize="15" FontWeight="SemiBold" Opacity="0.85" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <Button x:Name="SearchButton" Style="{StaticResource IconButton}" Click="Search_Click" ToolTip="Rechercher (Ctrl+F)">
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" />
                    </Button>
                    <Button x:Name="AddButton" Style="{StaticResource IconButton}" Click="Add_Click" ToolTip="Ajouter" Margin="2,0">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" />
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Ajouter un lien de flux…" Click="AddLink_Click" />
                                <MenuItem Header="Coller un lien (Ctrl+V)" Click="PasteLink_Click" />
                                <MenuItem Header="Ajouter une playlist…" Click="AddPlaylist_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Click="Settings_Click" ToolTip="Réglages">
                        <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" />
                    </Button>
                    <Button x:Name="AvatarButton" Style="{StaticResource PlainButton}" Click="Avatar_Click" Margin="10,0,0,0" ToolTip="Profil">
                        <Border x:Name="AvatarCircle" Width="36" Height="36" CornerRadius="18" Background="{DynamicResource AccentBrush}">
                            <TextBlock x:Name="AvatarText" FontWeight="Black" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" Height="2" VerticalAlignment="Bottom" Visibility="Collapsed"
                     Foreground="{DynamicResource AccentBrush}" Background="Transparent" BorderThickness="0" />

        <!-- Contenu -->
        <Grid Grid.Row="1" Background="{DynamicResource BackdropBrush}" ClipToBounds="True">
            <ContentControl x:Name="Host" Focusable="False" />

            <Border x:Name="Toast" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28"
                    Background="#F2202330" CornerRadius="12" Padding="18,11" BorderBrush="#33FFFFFF" BorderThickness="1"
                    Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock x:Name="ToastText" FontSize="14" />
            </Border>
        </Grid>
    </Grid>
</Window>
