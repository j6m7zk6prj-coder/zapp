<Window x:Class="ZappTV.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zapp TV" Width="1400" Height="860" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen" Icon="/Assets/app.ico"
        Background="{DynamicResource BgBrush}" Foreground="White" FontFamily="{StaticResource UiFont}"
        AllowDrop="True" Drop="Window_Drop" PreviewKeyDown="Window_PreviewKeyDown" PreviewMouseDown="Window_PreviewMouseDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Barre latérale -->
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,22,14,18">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,28">
                    <Image Source="/Assets/logo.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="ZAPP" FontSize="22" FontWeight="Black" Margin="10,0,7,0" VerticalAlignment="Center" />
                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                        <TextBlock Text="TV" FontWeight="Black" FontSize="12" Foreground="{DynamicResource OnAccentBrush}" />
                    </Border>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" FontSize="12" Margin="8,0,8,6" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" Height="3" Margin="8,0,8,10" Visibility="Collapsed"
                                 Foreground="{DynamicResource AccentBrush}" Background="#1FFFFFFF" BorderThickness="0" />
                    <Button x:Name="AddButton" Style="{StaticResource AccentButton}" Click="Add_Click" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="Ajouter" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Ajouter un lien de flux…" Click="AddLink_Click" />
                                <MenuItem Header="Coller un lien (Ctrl+V)" Click="PasteLink_Click" />
                                <MenuItem Header="Ajouter une playlist…" Click="AddPlaylist_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>

                <StackPanel>
                    <RadioButton x:Name="NavHome" Style="{StaticResource NavButton}" GroupName="Nav" Tag="home" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE80F;" />
                            <TextBlock Text="Accueil" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavLive" Style="{StaticResource NavButton}" GroupName="Nav" Tag="live" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE7F4;" />
                            <TextBlock Text="En direct" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavMovies" Style="{StaticResource NavButton}" GroupName="Nav" Tag="movies" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE8B2;" />
                            <TextBlock Text="Films" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavSeries" Style="{StaticResource NavButton}" GroupName="Nav" Tag="series" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE8F1;" />
                            <TextBlock Text="Séries" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavSearch" Style="{StaticResource NavButton}" GroupName="Nav" Tag="search" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE721;" />
                            <TextBlock Text="Recherche" />
                        </StackPanel>
                    </RadioButton>

                    <Border Height="1" Background="{StaticResource HairlineBrush}" Margin="10,14" />

                    <RadioButton x:Name="NavLinks" Style="{StaticResource NavButton}" GroupName="Nav" Tag="links" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE71B;" />
                            <TextBlock Text="Mes liens" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" GroupName="Nav" Tag="settings" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE713;" />
                            <TextBlock Text="Réglages" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Contenu -->
        <Grid Grid.Column="1" Background="{DynamicResource BackdropBrush}" ClipToBounds="True">
            <ContentControl x:Name="Host" Focusable="False" />

            <Button x:Name="BackButton" Style="{StaticResource CircleButton}" Width="40" Height="40"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="22,18,0,0"
                    Click="Back_Click" Visibility="Collapsed" ToolTip="Retour (Alt+←)">
                <TextBlock Text="&#xE72B;" Style="{StaticResource Icon}" FontSize="15" />
            </Button>

            <Border x:Name="Toast" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28"
                    Background="#F2202330" CornerRadius="12" Padding="18,11" BorderBrush="#33FFFFFF" BorderThickness="1"
                    Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock x:Name="ToastText" FontSize="14" />
            </Border>
        </Grid>
    </Grid>
</Window>
