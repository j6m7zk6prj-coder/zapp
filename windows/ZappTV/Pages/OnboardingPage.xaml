<UserControl x:Class="ZappTV.Pages.OnboardingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40,60">
            <Image Source="/Assets/logo.png" Width="96" Height="96" RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock HorizontalAlignment="Center" TextAlignment="Center" Margin="0,26,0,10" FontFamily="{StaticResource DisplayFont}" FontSize="48" FontWeight="SemiBold" LineHeight="54">
                <Run Text="Toute ta télé," /><LineBreak />
                <Run Text="sublimée." FontFamily="{StaticResource DisplaySerif}" FontStyle="Italic" FontWeight="Normal" Foreground="{DynamicResource AccentSoftBrush}" />
            </TextBlock>
            <TextBlock Text="Direct, films, séries et foot réunis dans une interface pensée pour le grand écran." FontSize="16" HorizontalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />

            <Border Style="{StaticResource GlassCard}" Padding="26,20" Margin="0,34,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6">
                        <TextBlock Text="&#xE71B;" Style="{StaticResource NavIcon}" Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="Ajoute tes liens un par un : HLS, TS, MKV, RTMP, RTSP, UDP…" FontSize="15" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6">
                        <TextBlock Text="&#xE8FD;" Style="{StaticResource NavIcon}" Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="Ou une playlist complète (M3U ou Xtream)" FontSize="15" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6">
                        <TextBlock Text="&#xE70F;" Style="{StaticResource NavIcon}" Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="Renomme, change les logos et les catégories" FontSize="15" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6">
                        <TextBlock Text="&#xE790;" Style="{StaticResource NavIcon}" Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="Choisis tes couleurs dans Réglages" FontSize="15" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Button Style="{StaticResource PrimaryButton}" Margin="0,30,0,0" Click="AddLink_Click" HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE71B;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,10,0" />
                    <TextBlock Text="Ajouter un lien" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource GhostButton}" Margin="0,12,0,0" Height="44" Padding="20,0" Click="AddPlaylist_Click"
                    HorizontalAlignment="Stretch" Content="Ajouter une playlist" FontWeight="SemiBold" FontSize="15" />

            <TextBlock Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,22,0,0"
                       Text="Astuce : copie un lien puis appuie sur Ctrl+V, ou glisse un fichier .m3u dans la fenêtre." />
            <TextBlock Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,10,0,0" FontSize="12"
                       Text="iTv ne fournit aucun contenu. Utilise uniquement des flux auxquels tu as légalement accès." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
