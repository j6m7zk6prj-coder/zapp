<UserControl x:Class="ZappTV.Pages.CatalogPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ZappTV.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="40,28,40,0">
            <StackPanel x:Name="LayoutPanel" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="GridModeButton" Style="{StaticResource Chip}" Click="Layout_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xF0E2;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="Mosaïque" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="ListModeButton" Style="{StaticResource Chip}" Click="Layout_Click" Margin="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8FD;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="Liste" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>
            <StackPanel>
                <TextBlock x:Name="TitleText" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="CountText" Style="{StaticResource Caption}" Margin="2,2,0,0" />
            </StackPanel>
        </DockPanel>

        <ScrollViewer x:Name="ChipsScroller" Grid.Row="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                      PreviewMouseWheel="Chips_PreviewMouseWheel" Focusable="False">
            <StackPanel x:Name="Chips" Orientation="Horizontal" Margin="40,18,40,12" />
        </ScrollViewer>

        <c:TileGrid x:Name="TilesView" Grid.Row="2" />
    </Grid>
</UserControl>
