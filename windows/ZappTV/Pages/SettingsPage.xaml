<UserControl x:Class="ZappTV.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="40,28,40,48" MaxWidth="960" HorizontalAlignment="Left">
            <TextBlock Text="Réglages" Style="{StaticResource PageTitle}" />

            <!-- Profil -->
            <TextBlock Text="Profil" Style="{StaticResource SectionTitle}" />
            <StackPanel x:Name="ProfileSection" />

            <!-- Playlists -->
            <TextBlock Text="Playlists" Style="{StaticResource SectionTitle}" />
            <TextBlock Style="{StaticResource Caption}"
                       Text="La playlist active est chargée au démarrage et rechargée toutes les 12 h (F5 pour forcer)." />
            <StackPanel x:Name="PlaylistRows" Margin="0,14,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Style="{StaticResource AccentButton}" Click="AddPlaylist_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="Ajouter une playlist" />
                    </StackPanel>
                </Button>
                <Button x:Name="RefreshButton" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="Refresh_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock x:Name="RefreshLabel" Text="Actualiser la playlist active" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Accueil -->
            <TextBlock Text="Accueil et navigation" Style="{StaticResource SectionTitle}" />
            <StackPanel x:Name="HomeSection" />

            <!-- TMDB -->
            <TextBlock Text="Fiches films et séries" Style="{StaticResource SectionTitle}" />
            <StackPanel x:Name="TmdbSection" />

            <!-- Foot -->
            <TextBlock Text="Foot" Style="{StaticResource SectionTitle}" />
            <StackPanel x:Name="FootSection" />

            <!-- Lecteur -->
            <TextBlock Text="Lecteur" Style="{StaticResource SectionTitle}" />
            <StackPanel x:Name="PlayerSection" />

            <!-- Apparence -->
            <TextBlock Text="Apparence" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Couleur d'accent" Style="{StaticResource FieldLabel}" />
            <WrapPanel x:Name="Swatches" />
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <TextBox x:Name="HexBox" Style="{StaticResource Field}" Width="150" Tag="#RRGGBB" />
                <Button Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="ApplyHex_Click" Content="Couleur personnalisée" />
            </StackPanel>

            <TextBlock Text="Fond" Style="{StaticResource FieldLabel}" />
            <WrapPanel x:Name="Backgrounds" />

            <TextBlock Text="Taille des affiches" Style="{StaticResource FieldLabel}" />
            <StackPanel x:Name="PosterSizes" Orientation="Horizontal" />

            <TextBlock Text="Affichage du direct" Style="{StaticResource FieldLabel}" />
            <StackPanel x:Name="LiveLayouts" Orientation="Horizontal" />

            <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,22,0,0" Click="ResetAppearance_Click"
                    Content="Réinitialiser l'apparence" />

            <!-- Masqués -->
            <TextBlock Text="Éléments masqués" Style="{StaticResource SectionTitle}" />
            <TextBlock x:Name="HiddenCaption" Style="{StaticResource Caption}" />
            <StackPanel x:Name="HiddenRows" Margin="0,10,0,0" />

            <!-- Raccourcis -->
            <TextBlock Text="Raccourcis clavier" Style="{StaticResource SectionTitle}" />
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="20,12" Margin="0,8,0,0">
                <StackPanel x:Name="Shortcuts" />
            </Border>

            <!-- À propos -->
            <TextBlock Text="À propos" Style="{StaticResource SectionTitle}" />
            <TextBlock x:Name="VersionText" FontSize="14" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                       Text="Lumio est uniquement un lecteur : il ne fournit aucune chaîne ni aucun contenu. Utilise seulement des liens et des playlists auxquels tu as légalement accès." />
            <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,14,0,0" Click="OpenData_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                    <TextBlock Text="Ouvrir le dossier des données" />
                </StackPanel>
            </Button>
        </StackPanel>
    </ScrollViewer>
</UserControl>
