<UserControl x:Class="ZappTV.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Catégories -->
        <StackPanel x:Name="Categories" Margin="20,28,12,20" />

        <!-- Contenu de la catégorie -->
        <ScrollViewer x:Name="PaneScroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel x:Name="Pane" Margin="24,28,40,48" MaxWidth="680" HorizontalAlignment="Left" />
        </ScrollViewer>
    </Grid>
</UserControl>
