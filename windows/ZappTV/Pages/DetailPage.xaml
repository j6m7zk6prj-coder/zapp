<UserControl x:Class="ZappTV.Pages.DetailPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <Grid>
            <!-- Fond flouté façon Apple TV -->
            <Grid x:Name="BackdropArea" Height="600" VerticalAlignment="Top" ClipToBounds="True" IsHitTestVisible="False">
                <Border x:Name="BackdropFallback" Opacity="0.45" />
                <Image x:Name="Backdrop" Stretch="UniformToFill" Opacity="0.65" RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Effect>
                        <BlurEffect x:Name="BackdropBlur" Radius="60" KernelType="Gaussian" />
                    </Image.Effect>
                </Image>
                <Rectangle Fill="{DynamicResource FadeLeftBrush}" />
                <Rectangle Fill="{DynamicResource FadeBottomBrush}" />
            </Grid>

            <StackPanel Margin="72,100,64,56">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="ArtBox" Width="230" Height="345" VerticalAlignment="Bottom">
                        <Grid.Effect>
                            <DropShadowEffect BlurRadius="40" ShadowDepth="12" Opacity="0.6" Direction="270" />
                        </Grid.Effect>
                        <Border x:Name="ArtFallback" CornerRadius="16">
                            <TextBlock x:Name="ArtInitials" FontSize="42" FontWeight="Black"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="ArtPoster" CornerRadius="16">
                            <Border.Background>
                                <ImageBrush x:Name="ArtBrush" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <Border x:Name="ArtLogoBox" CornerRadius="16" Background="{DynamicResource SurfaceHighBrush}" Visibility="Collapsed">
                            <Image x:Name="ArtLogo" Stretch="Uniform" Margin="30" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <Border CornerRadius="16" BorderBrush="#26FFFFFF" BorderThickness="1" />
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="44,0,0,4" VerticalAlignment="Bottom">
                        <TextBlock x:Name="KindText" Foreground="{DynamicResource AccentBrush}" FontWeight="Black" FontSize="13" />
                        <Image x:Name="TitleLogo" MaxHeight="130" MaxWidth="480" HorizontalAlignment="Left" Stretch="Uniform"
                               Margin="0,10,0,12" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock x:Name="TitleText" FontSize="46" FontWeight="Black" TextWrapping="Wrap" Margin="0,6,0,6" />
                        <TextBlock x:Name="TaglineText" FontFamily="{StaticResource DisplaySerif}" FontStyle="Italic" FontSize="19"
                                   Foreground="#E6FFFFFF" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed" />
                        <TextBlock x:Name="MetaText" FontSize="15" Foreground="#C7FFFFFF" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
                            <Button x:Name="PlayButton" Style="{StaticResource PrimaryButton}" MinWidth="170" Click="Play_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,10,0" />
                                    <TextBlock x:Name="PlayLabel" Text="Lire" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="TrailerButton" Style="{StaticResource GhostButton}" Margin="12,0,0,0" Click="Trailer_Click" Visibility="Collapsed"
                                    ToolTip="Regarder la bande-annonce sur YouTube" Padding="18,12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE714;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,9,0" />
                                    <TextBlock Text="Bande-annonce" FontWeight="SemiBold" FontSize="15" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="FavButton" Style="{StaticResource CircleButton}" Margin="14,0,0,0" Click="Fav_Click">
                                <TextBlock x:Name="FavGlyph" Style="{StaticResource Icon}" />
                            </Button>
                            <Button Style="{StaticResource CircleButton}" Margin="10,0,0,0" Click="Edit_Click" ToolTip="Modifier nom, logo, catégorie">
                                <TextBlock Text="&#xE70F;" Style="{StaticResource Icon}" />
                            </Button>
                            <Button Style="{StaticResource CircleButton}" Margin="10,0,0,0" Click="Hide_Click" ToolTip="Masquer">
                                <TextBlock Text="&#xED1A;" Style="{StaticResource Icon}" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="PlotText" FontSize="15" Foreground="#D9FFFFFF" TextWrapping="Wrap" MaxWidth="820"
                           HorizontalAlignment="Left" Margin="0,34,0,0" LineHeight="23" Visibility="Collapsed" />

                <StackPanel x:Name="CastSection" Visibility="Collapsed" Margin="0,36,0,0">
                    <TextBlock Text="Distribution" FontSize="22" FontWeight="Bold" Margin="0,0,0,14" />
                    <ScrollViewer x:Name="CastScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel x:Name="CastList" Orientation="Horizontal" Margin="0,0,0,10" />
                    </ScrollViewer>
                </StackPanel>

                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="16" Padding="22,6" Margin="0,30,0,0"
                        MaxWidth="760" MinWidth="460" HorizontalAlignment="Left">
                    <StackPanel x:Name="InfoRows" />
                </Border>

                <StackPanel x:Name="EpisodesSection" Visibility="Collapsed" Margin="0,40,0,0">
                    <TextBlock Text="Épisodes" FontSize="22" FontWeight="Bold" />
                    <WrapPanel x:Name="SeasonChips" Margin="0,16,0,8" />
                    <TextBlock x:Name="EpisodesStatus" Style="{StaticResource Caption}" FontSize="14" Margin="2,8" />
                    <StackPanel x:Name="EpisodesList" MaxWidth="1000" HorizontalAlignment="Left" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
