<UserControl x:Class="ZappTV.Pages.LinksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="LinkRowTemplate">
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="14,10" Margin="0,0,8,10" MaxWidth="1100" HorizontalAlignment="Stretch">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="112" Height="63">
                        <Border CornerRadius="10" Background="{Binding Name, Converter={StaticResource Gradient}}">
                            <TextBlock Text="{Binding Initials}" FontSize="18" FontWeight="Black"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border CornerRadius="10" Background="{DynamicResource SurfaceHighBrush}"
                                Visibility="{Binding HasLogo, Converter={StaticResource BoolToVisibility}}">
                            <Image Source="{Binding LogoUrl, Converter={StaticResource ImageUrl}, ConverterParameter=140}" Stretch="Uniform" Margin="10,7" />
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="18,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Detail}" FontSize="13" Margin="0,3,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding Url}" FontSize="12" Margin="0,3,0,0" Foreground="#66FFFFFF" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource CircleButton}" Width="42" Height="42" Click="Play_Click" Tag="{Binding}" ToolTip="Lire">
                            <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="14" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Margin="10,0,0,0" Click="Up_Click" Tag="{Binding}" ToolTip="Monter">
                            <TextBlock Text="&#xE70E;" Style="{StaticResource Icon}" FontSize="13" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Click="Down_Click" Tag="{Binding}" ToolTip="Descendre">
                            <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="13" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Margin="6,0,0,0" Click="Edit_Click" Tag="{Binding}" ToolTip="Modifier">
                            <TextBlock Text="&#xE70F;" Style="{StaticResource Icon}" FontSize="15" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Click="Delete_Click" Tag="{Binding}" ToolTip="Supprimer" Foreground="#FF7A7A">
                            <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="15" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="40,28,40,18">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource GhostButton}" Click="Paste_Click" Margin="0,0,10,0" ToolTip="Ctrl+V depuis n'importe quel écran">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE77F;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Coller un lien" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource AccentButton}" Click="Add_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="Ajouter un lien" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock x:Name="LinksTitle" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource Caption}" Margin="2,4,0,0"
                           Text="Tes flux ajoutés un par un : HLS, MP4, TS, MKV, RTMP, RTSP, UDP, SRT… tout est lu par VLC." />
            </StackPanel>
        </DockPanel>

        <ListBox x:Name="LinksList" Grid.Row="1" Style="{StaticResource PlainList}" Padding="40,0,24,30"
                 ItemTemplate="{StaticResource LinkRowTemplate}" />

        <StackPanel x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480">
            <TextBlock Text="&#xE71B;" Style="{StaticResource Icon}" FontSize="44" HorizontalAlignment="Center"
                       Foreground="{DynamicResource AccentBrush}" />
            <TextBlock Text="Aucun lien pour l'instant" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,16,0,6" />
            <TextBlock Style="{StaticResource Caption}" FontSize="14" TextAlignment="Center"
                       Text="Copie un lien de flux puis appuie sur Ctrl+V, glisse-le dans la fenêtre, ou clique sur « Ajouter un lien »." />
        </StackPanel>
    </Grid>
</UserControl>
