<UserControl x:Class="ZappTV.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ZappTV.Controls">
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="0,0,0,40">
            <c:HeroBanner x:Name="Hero" Margin="40,28,40,30" />
            <StackPanel x:Name="Sections" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
